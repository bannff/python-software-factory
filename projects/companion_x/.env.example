# Auto-generated by foreman — companion_x
# Copy to .env and fill in values

# --- api base ---
FACTORY_API_HOST=127.0.0.1
FACTORY_API_PORT=8000
# Select Companion-X's project-owned Workflow execution-engine registry.
WORKFLOW_CONFIG_DIR=projects/companion_x/config

# --- devtools project access ---
# Directories (os.pathsep-separated) the concierge's devtools tools may bind as
# project roots. Unset = parent of the API's launch directory (CWD-dependent).
# Projects must contain a marker (.git, pyproject.toml, or package.json) and
# sit >=4 path parts deep. Set to your home to cover repos + Desktop/Downloads.
# COMPANION_X_PROJECT_ALLOWED_ROOTS=/Users/you

# --- dashboard base ---
FACTORY_DASHBOARD_PORT=5001
FACTORY_APP_TITLE="Companion X"

# --- mcp_server base ---
MCP_SERVER_NAME=companion-x
MCP_INCLUDE_BRICKS=
MCP_EXCLUDE_BRICKS=
# Optional: path to a project pyproject.toml; when set, bricks are read from [tool.polylith.bricks] instead of BRICKS_INDEX.yaml
PROJECT_PYPROJECT=

# --- worker base ---
FACTORY_WORKER_BACKEND=memory
FACTORY_CELERY_BROKER_URL=redis://localhost:6379/1

# --- auth ---
# Native MCP auth is required. Local mode is explicit and forces loopback.
# Generate an ephemeral 16..512 character value. Both API and Next server
# processes receive it; the Next BFF never exposes it to browser JavaScript.
MCP_LOCAL_AUTH=true
# Generate a URL-safe token (the launcher does this automatically when blank):
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_LOCAL_AUTH_TOKEN=
MCP_LOCAL_AUTH_SUBJECT=local-operator
MCP_LOCAL_AUTH_ROLES=operator
MCP_AUTH_AUDIENCE=companion-x
MCP_AUTH_REQUIRED_SCOPES=
MCP_PERMISSIONS_CONFIG_DIR=config/mcp_permissions
AUTH_CONFIG_DIR=projects/companion_x/config/auth
FACTORY_AUTH_ADAPTER=memory
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=factory
KEYCLOAK_CLIENT_ID=factory-app
KEYCLOAK_CLIENT_SECRET=change-me

# --- cache ---
FACTORY_CACHE_ADAPTER=memory
REDIS_URL=redis://localhost:6379/0

# --- events ---
FACTORY_EVENTS_ADAPTER=sqlite
EVENTS_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0

# --- graph ---
FACTORY_GRAPH_ADAPTER=networkx
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- integrations ---
FACTORY_INTEGRATIONS_ADAPTER=rest

# --- kb ---
FACTORY_KB_ADAPTER=chromadb
KB_BACKEND=chromadb
KB_CHROMA_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=18100

# --- aws ---
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# --- llm_gateway ---
FACTORY_LLM_ADAPTER=ollama
FACTORY_LLM_EMBEDDING_ADAPTER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
# Companion-X framework-native chat model.
# - openrouter or openrouter/<vendor>/<model> → LangChain ChatOpenAI via OpenRouter
# - ollama/<model>             → LangChain ChatOllama
# - bare model id              → LangChain ChatBedrockConverse
# OpenRouter reasoning display is not part of M0; ordinary streaming and typed
# MCP tool calls still flow through LangGraph → AG-UI → CopilotKit v2.
COMPANION_X_CHAT_MODEL=openrouter
# Which chat models the picker offers (#136). Default `configured` serves the
# deployment's own choices: COMPANION_X_CHAT_MODEL plus every allowed
# openai-compat profile. Set `full` to also serve the live OpenRouter catalog
# (450+ ids, each marked "not configured" in the UI); set `configured` to pin a
# deployment to the scoped list so a client cannot ask for the rest. Any other
# value is treated as `configured` — a typo can only narrow, never widen.
COMPANION_X_MODEL_CATALOG_SCOPE=configured

# --- openai-compatible profiles (opencode / LM Studio / vLLM) ---
# COMPANION_X_CHAT_MODEL can select any allowed OpenAI-compatible profile with
# the `openai-compat/<name>` spelling (also selectable per-thread from the model
# catalog). Each profile is an env-var block named by its upper-case stem.
#
# opencode-go (the open model gateway): the /zen/go/v1 endpoint refuses a chat
# request with `400 MissingSessionID` unless a session header rides it, so set
# `<STEM>_SESSION_HEADER` to the provider's header name (its value is derived
# per conversation by the gateway — never configured, never secret).
#
# COMPANION_X_OPENAI_COMPAT_PROFILES lists the allowed profile names.
# COMPANION_X_OPENAI_COMPAT_REMOTE_ORIGINS allowlists the remote HTTPS origin;
# REQUIRED for opencode — without it the base URL below is refused and the
# profile resolves to the opaque "chat profile unavailable".
COMPANION_X_OPENAI_COMPAT_PROFILES=
COMPANION_X_OPENAI_COMPAT_REMOTE_ORIGINS=
# opencode-go example (uncomment to enable):
# COMPANION_X_OPENAI_COMPAT_PROFILES=opencode
# COMPANION_X_OPENAI_COMPAT_REMOTE_ORIGINS=https://opencode.ai
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_MODEL=deepseek-v4.1-flash
# OPENCODE_SESSION_HEADER=x-opencode-session
# OPENCODE_API_KEY=  # chat-completions models only (grok-4.x/muse-spark are
#                     # Responses-only and unsupported by this route).
# Key sourcing is a shell-only idiom (the launcher reads it; Compose env_file
# does NOT expand it — use a real secret store for containers):
#   OPENCODE_API_KEY="$(security find-generic-password -s <keychain-item> -w)"
# Durable local session metadata and official LangGraph checkpoints.
COMPANION_X_SESSION_DB_PATH=./.storage/sessions.db
# Dormant LangChain route: langgraph checkpoint DB (only read under
# AGENT_RUNTIME_ADAPTER=langchain / langgraph-legacy group).
COMPANION_X_CHECKPOINT_DB_PATH=./.storage/agent-checkpoints.db
# Default strands runtime: durable chat sessions (SqlSessionRepository,
# backend-swappable via storage.sql.backend).
COMPANION_X_STRANDS_SESSIONS_DB_PATH=./.storage/strands-sessions.db
# Persistent owner-scoped Crew and user-persona configuration.
FACTORY_AGENT_CONFIG_DIR=./.storage/agent-config
# Durable roots for the other two authoring surfaces (created on first write).
# FACTORY_AGENT_SKILLS_DIR=./.storage/agent-skills
# FACTORY_AGENT_STEERING_DIR=./.storage/agent-steering
#
# Authoring gates (issue #137/#138/#139). One variable per surface; the value
# is a comma-separated list of the ACTIONS that surface may perform. Any
# unknown token denies that whole surface (a typo never opens a surface).
#   skills          : add, delete
#   steering        : create, update, delete
#   agent_templates : create, delete, fork, reset
#   config          : read, write   (settings.yaml, tool modules, squads,
#                                    swarms/graphs; "write" does not open the
#                                    agent_templates surface — write_config
#                                    with kind=agent is denied without it)
#                                    NOTE: a tool-module write is imported and
#                                    executed by the registry on reload, so a
#                                    config write grant is a code-execution
#                                    grant; the per-surface partition only
#                                    decides whether that surface is open, it
#                                    does not bound what the module runs.
#   any surface     : all, none
# Exact precedence per (surface, action), first match wins:
#   1. that surface's variable above, when non-empty (blank == unset)
#   2. SUPER_AGENT_ENABLE_AUTHORING_TOOLS (the legacy ENV blanket switch)
#   3. settings.authoring.enabled — consulted ONLY while NO per-surface
#      variable is set at all
#   4. deny
# settings.yaml is writable through the config surface itself, so letting the
# persisted switch decide per-surface was a privilege-escalation path (a
# config-only grant could raise every other surface). With ANY per-surface
# variable set, settings.authoring.enabled is not consulted at all, and the
# config surface refuses to persist authoring.enabled=true
# (`authoring_gate_immutable`). With everything unset, every authoring action
# is denied (the read-only surface stays available).
FACTORY_AGENT_AUTHORING_SKILLS=
FACTORY_AGENT_AUTHORING_STEERING=
FACTORY_AGENT_AUTHORING_AGENT_TEMPLATES=
FACTORY_AGENT_AUTHORING_CONFIG=
# DEPRECATED blanket switch: still means "every surface, every action" when its
# surface variable is unset; prefer the per-surface variables above. A surface
# variable that is SET always wins, so a stale blanket switch cannot silently
# re-open a surface that was closed above. A malformed surface value does NOT
# fall through to this switch.
# SUPER_AGENT_ENABLE_AUTHORING_TOOLS=
# Required when COMPANION_X_CHAT_MODEL=openrouter.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Required only when COMPANION_X_CHAT_MODEL selects OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=2
# Optional OpenRouter attribution headers; neither value is a credential.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Companion-X
# Bedrock Claude-only extended-thinking budget (minimum 1024; ignored by OpenRouter).
COMPANION_X_CHAT_THINKING_BUDGET=16000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- bedrock mantle (OpenAI GPT-5.x via Responses API) ---
# GPT-5.5/5.4 are served ONLY through Bedrock's mantle endpoint (Responses
# API), resolved by strands_adapter._build_mantle_model for any persona whose
# model id starts with "openai.gpt-5" (e.g. the `developer` agent). A fresh
# bearer token is minted per request from the standard AWS credential chain
# (set AWS_PROFILE / AWS creds above) — no API key needed here.
# Region is gated by model availability: gpt-5.5 = us-east-2 ONLY;
# gpt-5.4 = us-east-2 or us-west-2. Independent of AWS_DEFAULT_REGION.
# Requires exact-pinned strands-agents[openai]==1.50.2, which owns the
# openai and token-generator dependencies, plus GPT model access in-region.
# Strands natively resolves /openai/v1 and refreshes the bearer token per request.
BEDROCK_MANTLE_REGION=us-east-2
# Reasoning effort: none|minimal|low|medium|high (AWS recommends >= medium).
BEDROCK_MANTLE_REASONING_EFFORT=medium
# Strands 1.50.2 resolves the native endpoint to /openai/v1. Set the
# optional escape hatch only for a custom full base URL; token refresh remains native.
# BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/openai/v1

# --- memory ---
FACTORY_MEMORY_ADAPTER=amem
MEMORY_BACKEND=amem
AMEM_STORAGE_PATH=./chroma_memory
# Optional A-MEM-only model override. This does not affect chat.
# AMEM_LLM_MODEL=us.amazon.nova-2-lite-v1:0
MEMORY_EMBEDDINGS=
ZEP_API_KEY=

# --- notification ---
FACTORY_NOTIFICATION_ADAPTER=stdio

# --- security ---
FACTORY_SECURITY_ADAPTER=mock

# --- storage ---
FACTORY_STORAGE_ADAPTER=memory
STORAGE_DOC_BACKEND=sqlite
STORAGE_GRAPH_BACKEND=networkx
POSTGRES_DSN=postgresql://factory:factory@localhost:5432/factory
AWS_S3_BUCKET=factory-storage

# --- telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
OTEL_SERVICE_NAME=factory

# --- workflow ---
FACTORY_WORKFLOW_ADAPTER=memory
DAGSTER_HOME=/opt/dagster/dagster_home

# --- strands context offloader ---
STRANDS_OFFLOAD_BACKEND=file
STRANDS_OFFLOAD_DIR=./.storage/offloaded
STRANDS_OFFLOAD_MAX_TOKENS=8000
STRANDS_OFFLOAD_PREVIEW_TOKENS=2500

# --- chat agent ---
# One trusted adapter bundle drives agent, chat, graph, and coordination.
# Leave unset for the default `strands` runtime (route flip, GH #89). The
# dormant LangChain/LangGraph bundle is selectable via AGENT_RUNTIME_ADAPTER=langchain
# (deps in the langgraph-legacy group). If you set AGENT_RUNTIME_CONFIG, the
# file must exist: nothing in the repo generates it (projects/*/config/ is
# gitignored) and a missing path fails the first chat turn with
# AgentRuntimeConfigError.
# AGENT_RUNTIME_CONFIG=projects/companion_x/config/agent-runtime.yaml

# --- chat streaming (strands stream_async → normalized AG-UI events) ---
CHAT_STREAMING=on

# --- shell / python_repl headless consent (bd:python-factory-wog0b) ---
# The HITL gate for shell + python_repl is ShellApprovalPlugin (the FE
# Approve/Deny card), NOT the strands_tools CLI consent prompt. On a headless
# API process the SDK's stdin prompt ("Do you want to proceed? [y/*]") has no
# TTY and DEADLOCKS the async SSE stream. Disable both consent paths so the
# plugin is the single source of truth:
#   STRANDS_NON_INTERACTIVE -> shell.py: kills consent + console UI + PTY stdin-watch
#   BYPASS_TOOL_CONSENT     -> python_repl.py: the ONLY var python_repl honors
STRANDS_NON_INTERACTIVE=true
BYPASS_TOOL_CONSENT=true

# Canonical in-process OpenTelemetry provenance exporter
TELEMETRY_CONFIG_DIR=projects/companion_x/telemetry
TELEMETRY_REQUIRED=1