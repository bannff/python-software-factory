    "cwe": "CWE-639",
    "service_name": "idor_warehouse",
    "artifact": {
      "type": "http_endpoint",
      "method": "GET",
      "path": "/warehouses/{code}",
      "app": "idor_warehouse"
    },
    "ground_truth": {
      "is_vulnerable": true,
      "statement": "GET /warehouses/<code> returns warehouse data without ownership check.",
      "description": "GET /warehouses/<code> returns warehouse data to any caller regardless of whether the requesting vendor owns the resource.",
      "severity": "high",
      "confidence": "confirmed"
    },
    "code_evidence": {
      "locations": [
        {
          "file": "app.py",
          "function": "get_warehouse",
          "line_start": 25,
          "line_end": 35,
          "cwe": "CWE-639",
          "description": "Returns warehouse data without checking if vendor_id == wh['owner']"
        }
      ]
    },
    "runtime_evidence": {
      "surface": {"endpoint": "/warehouses/{code}", "method": "GET"},
      "probe": {
        "method": "GET",
        "url": "http://localhost:5050/warehouses/ABCDE",
        "headers": {"X-Vendor-ID": "vendor-a"}
      },
      "expected_vulnerable_response": {"status": 200, "body_contains": {"owner": "vendor-b"}},
      "expected_secure_response": {"status": 403}
    },
    "exploit_evidence": {
      "description": "vendor-a reads vendor-b's warehouse data.",
      "reproduction_steps": [
        "curl -H 'X-Vendor-ID: vendor-a' http://localhost:5050/warehouses/ABCDE"
      ],
      "cross_tenant_access": true
    },
    "fix_evidence": {
      "description": "Add ownership check: if wh['owner'] != vendor_id: return 403"
    }
  },
