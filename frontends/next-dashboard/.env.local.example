# Backend API URL — read at runtime by route handlers (not baked at build time)
API_URL=http://localhost:8000

# Explicit localhost-only MCP credential projection. Keep the exact token equal
# to the API process value. These are server-only vars: never prefix NEXT_PUBLIC.
MCP_LOCAL_AUTH=true
MCP_LOCAL_AUTH_TOKEN=

# --- Repository chip (status bar) -------------------------------------------
# NEXT_PUBLIC_* values are INLINED INTO THE CLIENT BUNDLE at build time: they are
# public. Use a public label such as `github.com/owner/repo` — never paste an
# internal clone URL (`git remote get-url origin`) or anything credential-shaped.
# Unset -> the chip shows "local workspace" and renders no outbound link.
# NEXT_PUBLIC_REPO_LABEL=github.com/owner/repo
# NEXT_PUBLIC_REPO_URL=https://github.com/owner/repo
# NEXT_PUBLIC_GIT_BRANCH=main
